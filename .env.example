# Model & API Key Configuration
LLM_PROVIDER=ollama         # Options: ollama, gemini, openai, local
LLM_MODEL=qwen2.5:1.5b       # Model name

# Ollama Local LLM Settings (Experiment 3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Embeddings Configuration
EMBEDDING_PROVIDER=local     # Options: local (sentence-transformers), gemini, openai

# API Keys (Optional if using Ollama or Local mode)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
